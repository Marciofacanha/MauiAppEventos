<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppEventos.Views.EventoCadastrado"
             Title="Resumo do Evento"
             BackgroundColor="LightBlue">

    <VerticalStackLayout Padding="20" Spacing="10">

        <Label Text="{Binding Nome, StringFormat='Evento: {0}'}"
               FontSize="22" FontAttributes="Bold" />

        <Label Text="{Binding Local, StringFormat='Local: {0}'}" />

        <Label Text="{Binding DataInicio, StringFormat='Início: {0:dd/MM/yyyy}'}" />

        <Label Text="{Binding DataTermino, StringFormat='Término: {0:dd/MM/yyyy}'}" />

        <Label Text="{Binding Duracao.Days, StringFormat='Duração: {0} dia(s)'}" />

        <Label Text="{Binding QntParticipantes, StringFormat='Participantes: {0}'}" />

        <Label Text="{Binding CustoPorParticipante, StringFormat='Custo por participante: {0:C}'}" />

        <Label Text="{Binding CustoTotal, StringFormat='Custo total: {0:C}'}"
               FontSize="18" FontAttributes="Bold" />

    </VerticalStackLayout>
</ContentPage>